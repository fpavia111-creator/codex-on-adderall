    "bin/",
    "src/",
    "examples/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/",
    "test:integration": "node --test test/integration.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/codex-on-adderall.git"
