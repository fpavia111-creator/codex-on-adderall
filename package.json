    "multi-model",
    "agents",
    "budget",
    "spec"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@kurtfrancisco/specgate": "^0.3.0",
    "@kurtfrancisco/mcpscan": "^0.1.0",
